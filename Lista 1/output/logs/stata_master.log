(file C:\Users\B03531855158\Documents\Replication\Códigos/output/tables/stata_question_09_comparative.dta not found)

. 
. forvalues m = 1/7 {
  2.     local inst  "`Z`m''"
  3.     local model "Z`m'"
  4.     local k_inst : word count `inst'
  5. 
.     di as text _newline "[Stata] Estimando `model'"
  6.     di as text "[Stata] Instrumentos excluídos em `model': `inst'"
  7.     di as text "[Stata] Primeiro estágio `model': ln_pch ~ `inst' + ln_y + ln_pb"
  8. 
.     /**************************************************************
>      Primeiro estágio do modelo Zm
>     **************************************************************/
.     reg ln_pch `inst' ln_y ln_pb, vce(robust)
  9.     scalar N_fs = e(N)
 10. 
.     test `inst'
 11.     scalar F_usual = r(F)
 12.     scalar p_F     = r(p)
 13.     di as text "[Stata] `model' primeiro estágio: F usual=" %9.6f F_usual " | p=" %9.6f p_F
 14. 
.     * R2 parcial: residualiza ln_pch e cada instrumento nos controles.
.     di as text "[Stata] `model': calculando R2 parcial dos instrumentos excluídos condicional a ln_y e ln_pb"
 15.     preserve
 16.         keep if e(sample)
 17.         reg ln_pch ln_y ln_pb
 18.         predict double r_x, resid
 19.         local rinst ""
 20.         foreach v of local inst {
 21.             reg `v' ln_y ln_pb
 22.             predict double r_`v', resid
 23.             local rinst "`rinst' r_`v'"
 24.         }
 25.         reg r_x `rinst', noconstant
 26.         scalar partial_R2 = e(r2)
 27.     restore
 28.     di as text "[Stata] `model': R2 parcial = " %9.6f partial_R2
 29. 
.     post fst_all ("`model'") (N_fs) (`k_inst') (partial_R2) (F_usual) (p_F)
 30. 
.     /**************************************************************
>      2SLS estrutural com erro-padrão robusto
>     **************************************************************/
.     di as text "[Stata] `model' 2SLS: ln_q ~ ln_pch + ln_y + ln_pb; ln_pch instrumentado por `inst'"
 31.     ivreg2 ln_q ln_y ln_pb (ln_pch = `inst'), robust first
 32. 
.     scalar N_iv = e(N)
 33.     scalar b    = _b[ln_pch]
 34.     scalar se   = _se[ln_pch]
 35.     scalar cv   = invnormal(0.975)
 36. 
.     * p-valor de beta_p via normal assintótica.
.     scalar pval_p = 2 * (1 - normal(abs(b / se)))
 37.     di as text "[Stata] `model' 2SLS: beta_p=" %9.6f b " | EP=" %9.6f se " | p=" %9.6f pval_p
 38. 
.     * Hansen J: somente em modelos sobreidentificados.
.     if (`k_inst' <= 1) {
 39.         scalar J  = .
 40.         scalar Jp = .
 41.         di as text "[Stata] `model': Hansen J não se aplica; modelo exatamente identificado."
 42.     }
 43.     else {
 44.         cap scalar J  = e(j)
 45.         if _rc scalar J = .
 46.         cap scalar Jp = e(jp)
 47.         if _rc scalar Jp = .
 48.         di as text "[Stata] `model': Hansen J=" %9.6f J " | p=" %9.6f Jp
 49.     }
 50. 
.     /**************************************************************
>      weakivtest — F efetivo MOP e valores críticos
>     **************************************************************/
.     di as text "[Stata] `model': rodando weakivtest (Montiel Olea-Pflueger)"
 51.     cap noisily weakivtest
 52. 
.     if _rc {
 53.         scalar Feff = .
 54.         scalar cv5  = .
 55.         scalar cv10 = .
 56.         scalar cv20 = .
 57.         di as text "[Stata] `model': weakivtest não disponível — F_eff e valores críticos definidos como ."
 58.     }
 59.     else {
 60.         * Estatística F efetiva.
.         cap scalar Feff = r(F_eff)
 61.         if _rc scalar Feff = .
 62. 
.         * Valores críticos TSLS do weakivtest para tau = 5%, 10% e 20%.
.         * O weakivtest retorna estes nomes, como mostrado por return list:
.         *   r(c_TSLS_5), r(c_TSLS_10), r(c_TSLS_20)
.         cap scalar cv5 = r(c_TSLS_5)
 63.         if _rc scalar cv5 = .
 64.         cap scalar cv10 = r(c_TSLS_10)
 65.         if _rc scalar cv10 = .
 66.         cap scalar cv20 = r(c_TSLS_20)
 67.         if _rc scalar cv20 = .
 68.     }
 69. 
.     di as text "[Stata] `model': F efetivo MOP=" %9.6f Feff ///
>         " | cv5_TSLS=" %9.6f cv5 ///
>         " | cv10_TSLS=" %9.6f cv10 ///
>         " | cv20_TSLS=" %9.6f cv20
 70. 
.     * Log textual do weakivtest para cada modelo.
.     cap log close weaklog
 71.     log using "$TABS/stata_question_06_weakivtest_`model'.txt", replace text name(weaklog)
 72.         di "Modelo `model': instrumentos excluídos = `inst'"
 73.         cap noisily weakivtest
 74.         return list
 75.     log close weaklog
 76.     di as text "[Stata] `model': log do weakivtest salvo em output/tables/stata_question_06_weakivtest_`model'.txt"
 77. 
.     post comp ("`model'") (N_iv) (`k_inst') ///
>               (b) (se) (pval_p) (b - cv*se) (b + cv*se) ///
>               (F_usual) (p_F) (Feff) (cv5) (cv10) (cv20) ///
>               (J) (Jp)
 78. }

