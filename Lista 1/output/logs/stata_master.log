. di as text "[Stata] Modelos avaliados: Z1, Z2 e Z7"
[Stata] Modelos avaliados: Z1, Z2 e Z7

. di as text "[Stata] Para cada beta0: y_AR = ln_q - beta0*ln_pch; teste dos instrumentos excluídos em y_AR ~ controles 
> + instrumentos"
[Stata] Para cada beta0: y_AR = ln_q - beta0*ln_pch; teste dos instrumentos excluídos em y_AR ~ controles + instrumentos

. 
. /********************************************************************
>  Programa auxiliar: avalia uma grade AR na base atualmente carregada.
>  O programa deixa carregada a base da grade gerada.
> ********************************************************************/
. capture program drop ar_grid_scan

. program define ar_grid_scan, rclass
  1.     version 15
  2.     syntax varlist(min=1), BMIN(real) BMAX(real) STEP(real) ALPHA(real) OUTFILE(string)
  3. 
.     tempname arpost
  4.     postfile `arpost' double beta0 p_value accepted using "`outfile'", replace
  5. 
.     local ngrid   = floor((`bmax' - `bmin') / `step' + 0.5)
  6.     local npoints = `ngrid' + 1
  7. 
.     forvalues i = 0/`ngrid' {
  8.         local b0 = `bmin' + `i' * `step'
  9. 
.         cap drop y_ar
 10.         gen double y_ar = ln_q - (`b0') * ln_pch
 11. 
.         quietly regress y_ar ln_y ln_pb `varlist', vce(robust)
 12.         quietly test `varlist'
 13. 
.         scalar pval = r(p)
 14.         scalar acc  = (pval >= `alpha')
 15.         post `arpost' (`b0') (pval) (acc)
 16.     }
 17.     postclose `arpost'
 18. 
.     use "`outfile'", clear
 19. 
.     quietly count if accepted == 1
 20.     local nacc = r(N)
 21.     return scalar n_accepted = `nacc'
 22.     return scalar npoints    = `npoints'
 23. 
.     quietly summarize p_value, meanonly
 24.     local pmin = r(min)
 25.     local pmax = r(max)
 26.     return scalar p_min = `pmin'
 27.     return scalar p_max = `pmax'
 28. 
.     quietly summarize beta0 if abs(p_value - `pmax') < 1e-12, meanonly
 29.     return scalar beta0_minp = r(mean)
 30. 
.     if (`nacc' > 0) {
 31.         quietly summarize beta0 if accepted == 1, meanonly
 32.         return scalar ar_low  = r(min)
 33.         return scalar ar_high = r(max)
 34.     }
 35.     else {
 36.         return scalar ar_low  = .
 37.         return scalar ar_high = .
 38.     }
 39. end

. 
. postfile artab ///
>     str5 model int N k_inst ///
>     double ar_low ar_high ar_low_grid ar_high_grid beta0_minp p_min p_max ///
>     double grid_initial_min grid_initial_max grid_min grid_max grid_step ///
>     double coarse_step fine_step ///
>     int open_left open_right n_expand left_hits right_hits npoints_final ///
>     using "$TABS/stata_question_11_ar_intervals.dta", replace
(file C:\Users\B03531855158\Documents\Replication\Códigos/output/tables/stata_question_11_ar_intervals.dta not found)

. 
. local Z1 "z"

. local Z2 "z z_sq"

. local Z7 "z z_sq z_lag z_lag_sq"

. 
. * -------------------------------------------------------------------
. * Parâmetros principais.
. * -------------------------------------------------------------------
. local bmin0       = -5

. local bmax0       =  2

. local alpha       =  0.05

. 
. * Busca grossa: barata para localizar a região aceita.
. local coarse_step =  0.05

. 
. * Busca fina: usada no IC final reportado.
. local fine_step   =  0.005

. 
. * Expansão mínima e expansão proporcional.
. local min_expand  =  1

. local expand_mult =  0.75

. 
. * Limites de segurança.
. local max_expand   = 20

. local max_abs_beta = 100

. local lower_cap = -1 * `max_abs_beta'

. local upper_cap =  1 * `max_abs_beta'

. 
. * Detecção de cauda aberta.
. * Se a mesma borda for tocada min_tail_hits vezes, a rotina para
. * e reporta IC aberto naquele lado.
. local min_tail_hits = 3

. 
. foreach m in 1 2 7 {
  2.     local inst  "`Z`m''"
  3.     local model "Z`m'"
  4.     local k_inst : word count `inst'
  5. 
.     di as text _newline "[Stata] AR `model': instrumentos excluídos = `inst'"
  6. 
.     preserve
  7.         keep if !missing(ln_q, ln_pch, ln_y, ln_pb)
  8.         foreach v of local inst {
  9.             keep if !missing(`v')
 10.         }
 11.         count
 12.         scalar N_ar = r(N)
 13.         di as text "[Stata] AR `model': N = " N_ar
 14. 
.         tempfile arbase
 15.         save `arbase', replace
 16. 
.         local bmin_model = `bmin0'
 17.         local bmax_model = `bmax0'
 18.         local n_expand   = 0
 19.         local done       = 0
 20.         local left_hits  = 0
 21.         local right_hits = 0
 22. 
.         scalar ar_low_grid  = .
 23.         scalar ar_high_grid = .
 24.         scalar ar_low       = .
 25.         scalar ar_high      = .
 26.         scalar beta0_minp   = .
 27.         scalar p_min        = .
 28.         scalar p_max        = .
 29.         scalar open_left    = 0
 30.         scalar open_right   = 0
 31.         scalar n_accepted   = 0
 32.         scalar npoints_final = .
 33. 
.         /************************************************************
>          FASE 1: busca grossa adaptativa.
>         ************************************************************/
.         while (`done' == 0) {
 34.             use `arbase', clear
 35. 
.             tempfile argrid_coarse
 36.             di as text "[Stata] AR `model': busca grossa em [`bmin_model', `bmax_model'], passo `coarse_step'"
 37. 
.             ar_grid_scan `inst', ///
>                 bmin(`bmin_model') bmax(`bmax_model') ///
>                 step(`coarse_step') alpha(`alpha') ///
>                 outfile("`argrid_coarse'")
 38. 
.             scalar n_accepted  = r(n_accepted)
 39.             scalar ar_low_grid = r(ar_low)
 40.             scalar ar_high_grid = r(ar_high)
 41.             scalar beta0_minp  = r(beta0_minp)
 42.             scalar p_min       = r(p_min)
 43.             scalar p_max       = r(p_max)
 44. 
.             if (n_accepted == 0) {
 45.                 di as error "ATENÇÃO: AR `model' não aceitou nenhum beta0 na busca grossa corrente."
 46.                 di as text  "[Stata] AR `model': beta0 menos rejeitado = " %9.4f beta0_minp " | p_max = " %9.6f p_m
> ax
 47. 
.                 * Se a grade atual já está no limite absoluto e ainda assim
.                 * não há beta0 aceito, aí sim encerramos como conjunto vazio.
.                 if (`bmin_model' <= `lower_cap' & `bmax_model' >= `upper_cap') {
 48.                     local done = 1
 49.                 }
 50.                 else if (`n_expand' < `max_expand') {
 51.                     local width = `bmax_model' - `bmin_model'
 52.                     local delta = max(`min_expand', `width' * `expand_mult')
 53. 
.                     local bmin_model = `bmin_model' - `delta'
 54.                     local bmax_model = `bmax_model' + `delta'
 55. 
.                     if (`bmin_model' < `lower_cap') local bmin_model = `lower_cap'
 56.                     if (`bmax_model' > `upper_cap') local bmax_model = `upper_cap'
 57. 
.                     local n_expand = `n_expand' + 1
 58.                     di as error "         Ampliando ambos os lados para [`bmin_model', `bmax_model']."
 59. 
.                     * IMPORTANTE: não encerra imediatamente ao alcançar o cap.
.                     * A próxima iteração ainda avalia a grade capada, por exemplo
.                     * [-100, 100]. Só depois, se continuar sem aceitação, encerra.
.                 }
 60.                 else {
 61.                     local done = 1
 62.                 }
 63.             }
 64.             else {
 65.                 scalar open_left  = (ar_low_grid  <= `bmin_model' + `coarse_step')
 66.                 scalar open_right = (ar_high_grid >= `bmax_model' - `coarse_step')
 67. 
.                 if (open_left == 1)  local left_hits  = `left_hits'  + 1
 68.                 if (open_right == 1) local right_hits = `right_hits' + 1
 69. 
.                 di as text "[Stata] AR `model': IC grosso provisório = [" %9.3f ar_low_grid ", " %9.3f ar_high_grid "]
> "
 70.                 di as text "[Stata] AR `model': beta0 menos rejeitado = " %9.4f beta0_minp " | p_max = " %9.6f p_ma
> x " | p_min = " %9.6f p_min
 71. 
.                 * Regra central: se a mesma borda é tocada repetidamente,
.                 * tratamos como cauda aberta em vez de continuar expandindo.
.                 if (open_left == 1 & `left_hits' >= `min_tail_hits') {
 72.                     scalar open_left = 1
 73.                     di as error "ATENÇÃO: AR `model' toca repetidamente a borda esquerda. Tratando IC como aberto à
>  esquerda."
 74.                     local done = 1
 75.                 }
 76.                 if (open_right == 1 & `right_hits' >= `min_tail_hits') {
 77.                     scalar open_right = 1
 78.                     di as error "ATENÇÃO: AR `model' toca repetidamente a borda direita. Tratando IC como aberto à 
> direita."
 79.                     local done = 1
 80.                 }
 81. 
.                 if (`done' == 0) {
 82.                     if ((open_left == 1 | open_right == 1) & (`n_expand' < `max_expand')) {
 83.                         local width = `bmax_model' - `bmin_model'
 84.                         local delta = max(`min_expand', `width' * `expand_mult')
 85. 
.                         if (open_left == 1) {
 86.                             local bmin_model = `bmin_model' - `delta'
 87.                             if (`bmin_model' < `lower_cap') local bmin_model = `lower_cap'
 88.                             di as error "ATENÇÃO: AR `model' tocou a borda esquerda. Novo bmin = `bmin_model'."
 89.                         }
 90.                         if (open_right == 1) {
 91.                             local bmax_model = `bmax_model' + `delta'
 92.                             if (`bmax_model' > `upper_cap') local bmax_model = `upper_cap'
 93.                             di as error "ATENÇÃO: AR `model' tocou a borda direita. Novo bmax = `bmax_model'."
 94.                         }
 95. 
.                         local n_expand = `n_expand' + 1
 96. 
.                         if (`bmin_model' <= `lower_cap' & open_left == 1) {
 97.                             di as error "ATENÇÃO: AR `model' alcançou lower_cap. Tratando IC como aberto à esquerda
> ."
 98.                             scalar open_left = 1
 99.                             local done = 1
100.                         }
101.                         if (`bmax_model' >= `upper_cap' & open_right == 1) {
102.                             di as error "ATENÇÃO: AR `model' alcançou upper_cap. Tratando IC como aberto à direita.
> "
103.                             scalar open_right = 1
104.                             local done = 1
105.                         }
106.                     }
107.                     else {
108.                         local done = 1
109.                     }
110.                 }
111.             }
112.         }
113. 
.         /************************************************************
>          FASE 2: busca fina final na grade adaptada.
>         ************************************************************/
.         if (n_accepted > 0) {
114.             use `arbase', clear
115.             tempfile argrid_fine
116. 
.             di as text "[Stata] AR `model': busca fina final em [`bmin_model', `bmax_model'], passo `fine_step'"
117. 
.             ar_grid_scan `inst', ///
>                 bmin(`bmin_model') bmax(`bmax_model') ///
>                 step(`fine_step') alpha(`alpha') ///
>                 outfile("`argrid_fine'")
118. 
.             scalar n_accepted    = r(n_accepted)
119.             scalar npoints_final = r(npoints)
120.             scalar ar_low_grid   = r(ar_low)
121.             scalar ar_high_grid  = r(ar_high)
122.             scalar beta0_minp    = r(beta0_minp)
123.             scalar p_min         = r(p_min)
124.             scalar p_max         = r(p_max)
125. 
.             if (n_accepted > 0) {
126.                 * Mantém as flags de cauda aberta detectadas na fase grossa,
.                 * e também checa se a busca fina ainda toca a borda.
.                 scalar open_left  = (open_left  == 1 | ar_low_grid  <= `bmin_model' + `fine_step')
127.                 scalar open_right = (open_right == 1 | ar_high_grid >= `bmax_model' - `fine_step')
128. 
.                 scalar ar_low  = ar_low_grid
129.                 scalar ar_high = ar_high_grid
130. 
.                 * Se for aberto, ar_low/ar_high reportado fica missing no lado aberto.
.                 if (open_left == 1)  scalar ar_low  = .
131.                 if (open_right == 1) scalar ar_high = .
132.             }
133.             else {
134.                 scalar ar_low  = .
135.                 scalar ar_high = .
136.                 scalar open_left  = 0
137.                 scalar open_right = 0
138.             }
139.         }
140. 
.         if missing(ar_low_grid) & missing(ar_high_grid) {
141.             di as error "ATENÇÃO: AR `model' terminou sem intervalo aceito."
142.             di as error "         Veja beta0_minp e p_max para diagnosticar o ponto menos rejeitado."
143.         }
144.         else if (open_left == 1 & open_right == 1) {
145.             di as error "[Stata] AR `model': IC final = (-infinito, +infinito) dentro da lógica de inversão AR."
146.             di as text  "[Stata] AR `model': grade testada = [`bmin_model', `bmax_model']; IC na grade = [" %9.3f a
> r_low_grid ", " %9.3f ar_high_grid "]"
147.         }
148.         else if (open_left == 1) {
149.             di as error "[Stata] AR `model': IC final = (-infinito, " %9.3f ar_high_grid "]"
150.             di as text  "[Stata] AR `model': grade testada = [`bmin_model', `bmax_model']; limite inferior da grade
>  aceito = " %9.3f ar_low_grid
151.         }
152.         else if (open_right == 1) {
153.             di as error "[Stata] AR `model': IC final = [" %9.3f ar_low_grid ", +infinito)"
154.             di as text  "[Stata] AR `model': grade testada = [`bmin_model', `bmax_model']; limite superior da grade
>  aceito = " %9.3f ar_high_grid
155.         }
156.         else {
157.             di as text "[Stata] AR `model': IC final = [" %9.3f ar_low_grid ", " %9.3f ar_high_grid "]"
158.             di as text "[Stata] AR `model': grade final usada = [`bmin_model', `bmax_model']; passo final = `fine_s
> tep'"
159.         }
160. 
.     restore
161. 
.     post artab ("`model'") (N_ar) (`k_inst') ///
>                (ar_low) (ar_high) (ar_low_grid) (ar_high_grid) (beta0_minp) (p_min) (p_max) ///
>                (`bmin0') (`bmax0') ///
>                (`bmin_model') (`bmax_model') (`fine_step') ///
>                (`coarse_step') (`fine_step') ///
>                (open_left) (open_right) (`n_expand') (`left_hits') (`right_hits') (npoints_final)
162. }

