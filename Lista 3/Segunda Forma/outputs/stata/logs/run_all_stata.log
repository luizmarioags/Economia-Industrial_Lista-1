(38 observations deleted)

. mata:
------------------------------------------------- mata (type end to exit) ----------------------------------------------
:     p = st_data(., "price")

:     s = st_data(., "share")

:     a = st_numscalar("alpha_graph")

:     n = rows(s)

:     E = J(n,n,.)

:     for (j=1; j<=n; j++) {
>         for (k=1; k<=n; k++) {
>             if (j==k) E[j,k] = -a*p[j]*(1-s[j])
>             else E[j,k] = a*p[k]*s[k]
>         }
>     }

:     st_matrix("Egraph", E)

: end
------------------------------------------------------------------------------------------------------------------------

. clear

