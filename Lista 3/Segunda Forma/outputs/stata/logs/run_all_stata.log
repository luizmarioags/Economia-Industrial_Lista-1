. eststo GMM_nested_2

. 
. scalar sigma_nested = _b[sigma]

. display as text "Sigma nested = " %9.4f sigma_nested " ; intervalo teórico: 0 <= sigma < 1"
Sigma nested =    0.3462 ; intervalo teórico: 0 <= sigma < 1

. 
. * Resíduo estrutural nested.
. use "$OUTDATA/prepared_data_stata.dta", clear

. estimates restore GMM_nested_2
(results GMM_nested_2 are active now)

. gen xi_nested = delta - _b[b0] - _b[bcals]*cals - _b[bfat]*fat - _b[bsugar]*sugar - _b[bp]*price - _b[sigma]*log_share
> _within_nest

