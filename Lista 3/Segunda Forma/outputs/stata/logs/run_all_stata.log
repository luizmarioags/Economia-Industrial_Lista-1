. /****************************************************************************************
> 08 - Tabelas padronizadas em CSV e TEX
> -----------------------------------------------------------------------------------------
> Correção central:
> - Usa alpha estimado diretamente como coeficiente de neg_price = -price.
> - A comparação de preço reporta alpha e também price_coef = -alpha.
> - Elasticidades e markups são calculados sem abs() e sem imposição de demanda decrescente.
> - A inversão da matriz Delta usa qrsolve()/pinv(), evitando colapso numérico indevido.
> ****************************************************************************************/
. 
. capture program drop export_csv_tex

. program define export_csv_tex
  1.     syntax, CSV(string) TEX(string) [CAPTION(string) LABEL(string)]
  2.     export delimited using "`csv'", replace
  3.     export delimited using "`tex'", replace delimiter(tab)
  4. end

. 
. * -------------------------
. * 01. Coeficientes completos
. * -------------------------
. tempfile coefpost

. postfile coefh str48 model str32 parameter double estimate std_error t_stat p_value gmm_objective sigma_nested using `
> coefpost', replace
(file C:\Users\B03531~1\AppData\Local\Temp\21\ST_3a48_000001.tmp not found)

. 
. local allmodels "OLS IV_own IV_rival IV_both GMM_own_1 GMM_own_2 GMM_rival_1 GMM_rival_2 GMM_both_1 GMM_both_2 IV_nest
> ed GMM_nested_1 GMM_nested_2"

. foreach m of local allmodels {
  2.     capture estimates restore `m'
  3.     if !_rc {
  4.         local model_label "`m'"
  5.         if "`m'" == "OLS"          local model_label "Q1_MQO_logit_simples"
  6.         if "`m'" == "IV_own"       local model_label "Q2_2SLS_own_firm"
  7.         if "`m'" == "IV_rival"     local model_label "Q2_2SLS_rival_firms"
  8.         if "`m'" == "IV_both"      local model_label "Q2_2SLS_both"
  9.         if "`m'" == "GMM_own_1"    local model_label "Q3_GMM_own_firm_step1"
 10.         if "`m'" == "GMM_own_2"    local model_label "Q3_GMM_own_firm_2step"
 11.         if "`m'" == "GMM_rival_1"  local model_label "Q3_GMM_rival_firms_step1"
 12.         if "`m'" == "GMM_rival_2"  local model_label "Q3_GMM_rival_firms_2step"
 13.         if "`m'" == "GMM_both_1"   local model_label "Q3_GMM_both_step1"
 14.         if "`m'" == "GMM_both_2"   local model_label "Q3_GMM_both_2step"
 15.         if "`m'" == "IV_nested"    local model_label "Q4_2SLS_nested_reference"
 16.         if "`m'" == "GMM_nested_1" local model_label "Q4_nested_GMM_step1"
 17.         if "`m'" == "GMM_nested_2" local model_label "Q4_nested_GMM_2step"
 18. 
.         scalar obj = .
 19.         capture scalar obj = e(Q)
 20.         scalar sig = .
 21.         capture scalar sig = _b[log_share_within_nest]
 22.         capture scalar sig = _b[sigma]
 23. 
.         if strpos("`m'", "GMM") {
 24.             foreach pair in "const b0" "cals bcals" "fat bfat" "sugar bsugar" "alpha alpha" "sigma sigma" {
 25.                 gettoken pname bref : pair
 26.                 capture scalar bhat = _b[`bref']
 27.                 if !_rc {
 28.                     capture scalar sehat = _se[`bref']
 29.                     if _rc scalar sehat = .
 30.                     scalar tstat = bhat/sehat
 31.                     scalar pval = 2*normal(-abs(tstat))
 32.                     post coefh ("`model_label'") ("`pname'") (bhat) (sehat) (tstat) (pval) (obj) (sig)
 33.                 }
 34.             }
 35.         }
 36.         else {
 37.             foreach pair in "const _cons" "cals cals" "fat fat" "sugar sugar" "alpha neg_price" "sigma log_share_wi
> thin_nest" {
 38.                 gettoken pname bref : pair
 39.                 capture scalar bhat = _b[`bref']
 40.                 if !_rc {
 41.                     capture scalar sehat = _se[`bref']
 42.                     if _rc scalar sehat = .
 43.                     scalar tstat = bhat/sehat
 44.                     capture scalar pval = 2*ttail(e(df_r), abs(tstat))
 45.                     if _rc scalar pval = 2*normal(-abs(tstat))
 46.                     post coefh ("`model_label'") ("`pname'") (bhat) (sehat) (tstat) (pval) (obj) (sig)
 47.                 }
 48.             }
 49.         }
 50.     }
 51. }

. postclose coefh

. use `coefpost', clear

