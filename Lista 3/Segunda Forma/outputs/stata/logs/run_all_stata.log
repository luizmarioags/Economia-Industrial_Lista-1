. * Exportação padronizada em CSV/TEX fica em 08_standard_tables.do.
. 
end of do-file

. do "$ROOT/stata/03_nested_gmm.do"

. /****************************************************************************************
> 03 - Nested logit por GMM usando eberry/b_program como base operacional
> ****************************************************************************************
> COMENTÁRIOS DETALHADOS
> - O 2SLS nested continua como referência linear.
> - O GMM nested NÃO usa mais o comando nativo gmm do Stata.
> - O núcleo operacional é o mesmo de eberry/b_program: eberry_fit define Y, X, Z e
>   berry_gmm_code resolve o critério GMM em Mata.
> - Os estimates são mantidos como IV_nested, GMM_nested_1 e GMM_nested_2.
> ****************************************************************************************/
. 
. use "$OUTDATA/prepared_data_stata.dta", clear

. 
. quietly run "$ROOT/stata/eberry_operational.do"

. 
. global ZOWN     "own_cals own_fat own_sugar"

. global ZRIVAL   "rival_cals rival_fat rival_sugar"

. global ZNEST    "n_same_nest_other n_rival_nest nest_own_cals nest_own_fat nest_own_sugar nest_rival_cals nest_rival_f
> at nest_rival_sugar"

. global ZNESTALL "$ZOWN $ZRIVAL $ZNEST"

. 
. * Referência 2SLS com duas endógenas: preço e log(s_j|g).
. ivregress 2sls delta $XVARS (price log_share_within_nest = $ZNESTALL), vce(robust)
note: n_rival_nest omitted because of collinearity.
note: nest_own_fat omitted because of collinearity.
note: nest_own_sugar omitted because of collinearity.
note: nest_rival_cals omitted because of collinearity.
note: nest_rival_fat omitted because of collinearity.
note: nest_rival_sugar omitted because of collinearity.
note: rival_cals omitted because of collinearity.
note: rival_fat omitted because of collinearity.
note: rival_sugar omitted because of collinearity.

Instrumental-variables 2SLS regression            Number of obs   =         50
                                                  Wald chi2(5)    =      19.82
                                                  Prob > chi2     =     0.0014
                                                  R-squared       =     0.5572
                                                  Root MSE        =     .33096

---------------------------------------------------------------------------------------
                      |               Robust
                delta | Coefficient  std. err.      z    P>|z|     [95% conf. interval]
----------------------+----------------------------------------------------------------
                price |  -.3414074   .2142227    -1.59   0.111    -.7612761    .0784614
log_share_within_nest |   .4126007   .1245171     3.31   0.001     .1685517    .6566497
                 cals |   .0020777   .0020141     1.03   0.302    -.0018698    .0060252
                  fat |  -.0087123   .0304529    -0.29   0.775    -.0683988    .0509742
                sugar |  -.0291902   .0109055    -2.68   0.007    -.0505645   -.0078158
                _cons |  -.6720501   1.008852    -0.67   0.505    -2.649364    1.305264
---------------------------------------------------------------------------------------
Endogenous: price log_share_within_nest
Exogenous:  cals fat sugar own_cals own_fat own_sugar n_same_nest_other nest_own_cals

. eststo IV_nested

. 
. /****************************************************************************************
> GMM nested:
>     delta_j = b0 + bcals*cals_j + bfat*fat_j + bsugar*sugar_j
>               + bp*price_j + sigma*ln(s_{j|g}) + xi_j.
> ****************************************************************************************/
. 
. eberry_fit, ///
>     y("delta") ///
>     x("cons cals fat sugar price log_share_within_nest") ///
>     z("cons cals fat sugar $ZNESTALL") ///
>     bnames("b0 bcals bfat bsugar bp sigma") ///
