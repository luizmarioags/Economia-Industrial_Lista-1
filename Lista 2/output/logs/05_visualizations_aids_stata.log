. foreach mat in marshallianas compensadas {                                      // Percorre os dois tipos de elasticidade.
  2.     local titulo_elast "Elasticidades nao compensadas"
  3.     if "`mat'" == "compensadas" local titulo_elast "Elasticidades compensadas"
  4.     preserve                                                                    // Preserva base atual.
  5.     if "`mat'" == "marshallianas" {                                             // Verifica se é matriz Marshalliana.
  6.         import delimited using "$TABLES/elasticidades_marshallianas_hsym_stata.csv", clear // Importa Marshallianas.
  7.     }                                                                           // Fecha condição.
  8.     if "`mat'" == "compensadas" {                                               // Verifica se é matriz compensada.
  9.         import delimited using "$TABLES/elasticidades_compensadas_hsym_stata.csv", clear // Importa compensadas.
 10.     }                                                                           // Fecha condição.
 11.     rename bfvl valor_bfvl                                                      // Renomeia coluna bfvl para reshape.
 12.     rename pork valor_pork                                                      // Renomeia coluna pork para reshape.
 13.     rename poult valor_poult                                                    // Renomeia coluna poult para reshape.
 14.     rename fish valor_fish                                                      // Renomeia coluna fish para reshape.
 15.     reshape long valor_, i(produto_linha) j(produto_coluna) string              // Coloca a matriz em formato longo.
 16.     gen row = .                                                                 // Cria posição da linha.
 17.     replace row = 4 if produto_linha == "bfvl"                                  // Posiciona bfvl no topo.
 18.     replace row = 3 if produto_linha == "pork"                                  // Posiciona pork.
 19.     replace row = 2 if produto_linha == "poult"                                 // Posiciona poult.
 20.     replace row = 1 if produto_linha == "fish"                                  // Posiciona fish.
 21.     gen col = .                                                                 // Cria posição da coluna.
 22.     replace col = 1 if produto_coluna == "bfvl"                                 // Posiciona coluna bfvl.
 23.     replace col = 2 if produto_coluna == "pork"                                 // Posiciona coluna pork.
 24.     replace col = 3 if produto_coluna == "poult"                                // Posiciona coluna poult.
 25.     replace col = 4 if produto_coluna == "fish"                                 // Posiciona coluna fish.
 26.     gen str8 rotulo = string(valor_, "%5.2f")                                   // Cria rótulo numérico da célula.
 27.     gen double peso = abs(valor_) + 0.05                                         // Cria peso positivo para tamanho do marcador.
 28.     twoway ///
>         (scatter row col if produto_coluna == "bfvl" [aw=peso], msymbol(square) msize(vlarge) mcolor(`cor_bovina'%65) mlabcolor(black) mlabel(rotulo) mlabposition(0) mlabsize(small)) ///
>         (scatter row col if produto_coluna == "pork" [aw=peso], msymbol(square) msize(vlarge) mcolor(`cor_suina'%65) mlabcolor(black) mlabel(rotulo) mlabposition(0) mlabsize(small)) ///
>         (scatter row col if produto_coluna == "poult" [aw=peso], msymbol(square) msize(vlarge) mcolor(`cor_frango'%65) mlabcolor(black) mlabel(rotulo) mlabposition(0) mlabsize(small)) ///
>         (scatter row col if produto_coluna == "fish" [aw=peso], msymbol(square) msize(vlarge) mcolor(`cor_pescados'%65) mlabcolor(black) mlabel(rotulo) mlabposition(0) mlabsize(small)), ///
>         xlabel(1 "bfvl" 2 "pork" 3 "poult" 4 "fish", angle(0) labsize(small)) ///
>         ylabel(1 "fish" 2 "poult" 3 "pork" 4 "bfvl", labsize(small)) ///
>         title("`titulo_elast'", size(medsmall)) ///
>         xtitle("Preço: nome da variável", size(small)) ///
>         ytitle("Demanda: nome da variável", size(small)) ///
>         legend(order(1 "Carne bovina e vitela" 2 "Carne suína" 3 "Frango" 4 "Pescados") cols(1) position(3) ring(1) region(lcolor(none) fcolor(none)) size(small)) ///
>         `tema_base' name(g_elast_`mat', replace) // Mapa de células das elasticidades com cores por variável e legenda à direita.
 29.     graph export "$FIGURES_PDF/stata_20_matriz_elasticidades_`mat'.pdf", replace    // Exporta matriz em PDF.
 30.     graph export "$FIGURES_PNG/stata_20_matriz_elasticidades_`mat'.png", replace width(2400) // Exporta matriz em PNG.
 31.     restore                                                                     // Restaura base.
 32. }                                                                               // Fecha loop de elasticidades.
