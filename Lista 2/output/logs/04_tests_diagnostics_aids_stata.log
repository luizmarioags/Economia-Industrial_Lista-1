. foreach g in bfvl pork poult fish {                // Percorre cada preço para diagnóstico alternativo.
  2.     quietly regress lngp_`g' ln_real_x L1_lngp_bfvl L1_lngp_pork L1_lngp_poult L1_lngp_fish L2_lngp_bfvl L2_lngp_pork L2_lngp_poult L2_lngp_fish // Estima primeira etapa com L1 e L2.
  3.     scalar r2_full = e(r2)                         // Guarda R2 do modelo completo.
  4.     scalar n_full = e(N)                           // Guarda número de observações.
  5.     test L1_lngp_bfvl L1_lngp_pork L1_lngp_poult L1_lngp_fish L2_lngp_bfvl L2_lngp_pork L2_lngp_poult L2_lngp_fish // Testa instrumentos L1 e L2.
  6.     scalar F_ex = r(F)                             // Guarda F da primeira etapa ampliada.
  7.     scalar p_ex = r(p)                             // Guarda p-valor da primeira etapa ampliada.
  8.     quietly regress lngp_`g' ln_real_x             // Estima modelo reduzido apenas com variável incluída.
  9.     scalar r2_red = e(r2)                          // Guarda R2 do modelo reduzido.
 10.     scalar r2_par = (r2_full - r2_red)/(1 - r2_red) // Calcula R2 parcial dos instrumentos ampliados.
 11.     post `postfs' ("`g'") ("L1_L2") (F_ex) (p_ex) (r2_full) (r2_red) (r2_par) (n_full) // Grava diagnóstico L1+L2.
 12. }                                                  // Fecha loop de preços.

