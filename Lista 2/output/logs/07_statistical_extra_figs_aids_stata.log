.     quietly levelsof year if e(sample), local(anos_fs)
  8.     foreach yy of local anos_fs {
  9.         quietly summarize cook_`g' if year == `yy', meanonly
 10.         scalar scook = r(mean)
 11.         quietly summarize lev_`g' if year == `yy', meanonly
 12.         scalar slev = r(mean)
 13.         quietly summarize rst_`g' if year == `yy', meanonly
 14.         scalar srst = r(mean)
 15.         quietly summarize fit_`g' if year == `yy', meanonly
 16.         scalar sfit = r(mean)
 17.         quietly summarize lngp_`g' if year == `yy', meanonly
 18.         scalar sobs = r(mean)
 19.         post `postfs' ("`g'") (`yy') (scook) (slev) (srst) (sfit) (sobs)
 20.     }
 21. 
.     drop cook_`g' lev_`g' rst_`g' fit_`g'
 22. }

