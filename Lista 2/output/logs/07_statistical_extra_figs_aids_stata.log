. ********************************************************************************
. * Checagem de arquivos necessarios.
. ********************************************************************************
. 
. foreach arq in ///
>     "$PROC_DTA" ///
>     "$MODELS/aids_hsym.ster" ///
>     "$MODELS/aids_hsym_L2.ster" {
  2. 
.     capture confirm file "`arq'"
  3.     if _rc {
  4.         di as error "Arquivo necessario nao encontrado: `arq'"
  5.         di as error "Rode antes o pacote principal: do stata/run_all_aids_stata.do"
  6.         log close
  7.         exit 601
  8.     }
  9. }

