. ********************************************************************************
. * Programas auxiliares.
. ********************************************************************************
. 
. capture program drop _fit_hsym_aids

. program define _fit_hsym_aids
  1.     syntax [, L2]
  2. 
.     if "`l2'" == "" {
  3.         local Z "ln_real_x L1_lngp_bfvl L1_lngp_pork L1_lngp_poult L1_lngp_fish"
  4.     }
  5.     else {
  6.         local Z "ln_real_x L1_lngp_bfvl L1_lngp_pork L1_lngp_poult L1_lngp_fish L2_lngp_bfvl L2_lngp_pork L2_lngp_poult L2_lngp_fish"
  7.     }
  8. 
.     gmm                                                                          ///
>         (eq_bfvl: w_bfvl - {a_bfvl} - {g11}*(lngp_bfvl-lngp_poult) - {g12}*(lngp_pork-lngp_poult) - {g14}*(lngp_fish-lngp_poult) - {b_bfvl}*ln_real_x) ///
>         (eq_pork: w_pork - {a_pork} - {g12}*(lngp_bfvl-lngp_poult) - {g22}*(lngp_pork-lngp_poult) - {g24}*(lngp_fish-lngp_poult) - {b_pork}*ln_real_x) ///
>         (eq_fish: w_fish - {a_fish} - {g14}*(lngp_bfvl-lngp_poult) - {g24}*(lngp_pork-lngp_poult) - {g44}*(lngp_fish-lngp_poult) - {b_fish}*ln_real_x), ///
>         instruments(eq_bfvl: `Z')                                               ///
>         instruments(eq_pork: `Z')                                               ///
>         instruments(eq_fish: `Z')                                               ///
>         winitial(unadjusted, independent) wmatrix(unadjusted) twostep nolog
  9. end

. 
. capture program drop _calc_own_elast_hsym

. program define _calc_own_elast_hsym, rclass
  1. 
.     quietly summarize w_bfvl if e(sample), meanonly
  2.     scalar wbar_bfvl = r(mean)
  3.     quietly summarize w_pork if e(sample), meanonly
  4.     scalar wbar_pork = r(mean)
  5.     quietly summarize w_poult if e(sample), meanonly
  6.     scalar wbar_poult = r(mean)
  7.     quietly summarize w_fish if e(sample), meanonly
  8.     scalar wbar_fish = r(mean)
  9. 
.     scalar b_bfvl  = _b[/b_bfvl]
 10.     scalar b_pork  = _b[/b_pork]
 11.     scalar b_fish  = _b[/b_fish]
 12.     scalar b_poult = - b_bfvl - b_pork - b_fish
 13. 
.     scalar g11 = _b[/g11]
 14.     scalar g12 = _b[/g12]
 15.     scalar g14 = _b[/g14]
 16.     scalar g22 = _b[/g22]
 17.     scalar g24 = _b[/g24]
 18.     scalar g44 = _b[/g44]
 19. 
.     scalar g13 = -(g11 + g12 + g14)
 20.     scalar g21 = g12
 21.     scalar g23 = -(g21 + g22 + g24)
 22.     scalar g31 = g13
 23.     scalar g32 = g23
 24.     scalar g34 = -(g14 + g24 + g44)
 25.     scalar g41 = g14
 26.     scalar g42 = g24
 27.     scalar g43 = g34
 28.     scalar g33 = -(g31 + g32 + g34)
 29. 
.     scalar eta_bfvl  = 1 + b_bfvl/wbar_bfvl
 30.     scalar eta_pork  = 1 + b_pork/wbar_pork
 31.     scalar eta_poult = 1 + b_poult/wbar_poult
 32.     scalar eta_fish  = 1 + b_fish/wbar_fish
 33. 
.     scalar em_bfvl  = -1 + g11/wbar_bfvl  - b_bfvl
 34.     scalar em_pork  = -1 + g22/wbar_pork  - b_pork
 35.     scalar em_poult = -1 + g33/wbar_poult - b_poult
 36.     scalar em_fish  = -1 + g44/wbar_fish  - b_fish
 37. 
.     scalar eh_bfvl  = em_bfvl  + eta_bfvl*wbar_bfvl
 38.     scalar eh_pork  = em_pork  + eta_pork*wbar_pork
 39.     scalar eh_poult = em_poult + eta_poult*wbar_poult
 40.     scalar eh_fish  = em_fish  + eta_fish*wbar_fish
 41. 
.     return scalar eta_bfvl  = eta_bfvl
 42.     return scalar eta_pork  = eta_pork
 43.     return scalar eta_poult = eta_poult
 44.     return scalar eta_fish  = eta_fish
 45. 
.     return scalar em_bfvl  = em_bfvl
 46.     return scalar em_pork  = em_pork
 47.     return scalar em_poult = em_poult
 48.     return scalar em_fish  = em_fish
 49. 
.     return scalar eh_bfvl  = eh_bfvl
 50.     return scalar eh_pork  = eh_pork
 51.     return scalar eh_poult = eh_poult
 52.     return scalar eh_fish  = eh_fish
 53. end

. 
. capture program drop _make_residual_data_hsym

. program define _make_residual_data_hsym
  1. 
.     use "$PROC_DTA", clear
  2.     drop if missing(w_bfvl, w_pork, w_poult, w_fish, lngp_bfvl, lngp_pork, lngp_poult, lngp_fish, ln_real_x, L1_lngp_bfvl, L1_lngp_pork, L1_lngp_poult, L1_lngp_fish)
  3. 
.     estimates use "$MODELS/aids_hsym.ster"
  4. 
.     scalar a_bfvl = _b[/a_bfvl]
  5.     scalar a_pork = _b[/a_pork]
  6.     scalar a_fish = _b[/a_fish]
  7. 
.     scalar b_bfvl = _b[/b_bfvl]
  8.     scalar b_pork = _b[/b_pork]
  9.     scalar b_fish = _b[/b_fish]
 10. 
.     scalar g11 = _b[/g11]
 11.     scalar g12 = _b[/g12]
 12.     scalar g14 = _b[/g14]
 13.     scalar g22 = _b[/g22]
 14.     scalar g24 = _b[/g24]
 15.     scalar g44 = _b[/g44]
 16. 
.     gen double fit_bfvl = a_bfvl + g11*(lngp_bfvl-lngp_poult) + g12*(lngp_pork-lngp_poult) + g14*(lngp_fish-lngp_poult) + b_bfvl*ln_real_x
 17.     gen double fit_pork = a_pork + g12*(lngp_bfvl-lngp_poult) + g22*(lngp_pork-lngp_poult) + g24*(lngp_fish-lngp_poult) + b_pork*ln_real_x
 18.     gen double fit_fish = a_fish + g14*(lngp_bfvl-lngp_poult) + g24*(lngp_pork-lngp_poult) + g44*(lngp_fish-lngp_poult) + b_fish*ln_real_x
 19.     gen double fit_poult = 1 - fit_bfvl - fit_pork - fit_fish
 20. 
.     gen double res_bfvl  = w_bfvl  - fit_bfvl
 21.     gen double res_pork  = w_pork  - fit_pork
 22.     gen double res_poult = w_poult - fit_poult
 23.     gen double res_fish  = w_fish  - fit_fish
 24. 
.     foreach g in bfvl pork poult fish {
 25.         quietly summarize res_`g'
 26.         gen double zres_`g' = (res_`g' - r(mean))/r(sd)
 27.     }
 28. 
.     order year w_* fit_* res_* zres_*
 29.     save "$TABLES/diagnosticos_residuos_hsym_stata.dta", replace
 30.     export delimited using "$TABLES/diagnosticos_residuos_hsym_stata.csv", replace
 31. end

. 
